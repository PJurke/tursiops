<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tursiops.Core\Tursiops.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The demo uses the example ontology itself, so there is no second copy that could drift (E-39). -->
    <EmbeddedResource Include="..\..\examples\mensch.tur" LogicalName="mensch.tur" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
